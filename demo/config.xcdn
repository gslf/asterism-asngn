// asngn demo engine root — try the TUI from the repository:
//
//   ./build/asngn --root demo
//
// The tool registry points at the astools std packages assembled by the
// build (fs, grep, edit, git, proc, env, sys). Model weights are NOT
// bundled: download the reference pool into demo/models/ (see
// tests/quality/README.md) to chat. This is a coding profile, so missing
// models/tools/workspace/sandbox fail fast; pass --allow-degraded only when
// deliberately inspecting the UI without a ready runtime.

#asngn_config {
  engine: {
    profile: "coding",
    base_prompt: """You are asngn, a frugal local assistant. Answer
plainly and honestly; use the tools when the task touches the
machine.""",
  },
  integration: {
    asper: { enable: true, root: "memory" },
    astools: {
      enable: true,
      root: "../build/packages",   // std tool suite from the build
      workspace: "workspace",
    },
  },
  telemetry: {
    path: "telemetry/telemetry.xcdn",
  },
  logging: {
    path: "asngn.log",
    level: "info",
  },
}
